@model CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
    var notices = ViewBag.Notices as IEnumerable<string> ?? Enumerable.Empty<string>();
    var placeholder = Url.Content("~/images/default-product.svg");
}

<h1 class="h2 fw-bold mb-4"><i class="fa-solid fa-cart-shopping text-primary me-2"></i>Shopping Cart</h1>

@foreach (var notice in notices)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-1"></i> @notice
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <i class="fa-solid fa-basket-shopping fa-4x text-muted mb-3"></i>
            <h4>Your cart is empty</h4>
            <p class="text-muted">Looks like you haven't added anything yet.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-2">Browse products</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="d-none d-md-table-cell">Price</th>
                                <th>Quantity</th>
                                <th class="text-end">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr id="cart-row-@item.ProductId" data-cart-row>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@Url.ProductImage(item.ImageUrl)" data-fallback="@placeholder" class="cart-thumb" alt="" />
                                            <a class="fw-semibold text-decoration-none text-body" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a>
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell">@item.UnitPrice.ToEgp()</td>
                                    <td>
                                        <div class="qty-stepper sm">
                                            <button type="button" class="btn" data-qty-step="-1" aria-label="Decrease quantity"><i class="fa-solid fa-minus"></i></button>
                                            <input type="number" class="form-control" value="@item.Quantity" data-last="@item.Quantity"
                                                   min="1" max="@CartViewModel.MaxQuantityPerItem"
                                                   data-cart-qty data-product-id="@item.ProductId" aria-label="Quantity" />
                                            <button type="button" class="btn" data-qty-step="1" aria-label="Increase quantity"><i class="fa-solid fa-plus"></i></button>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <span id="subtotal-@item.ProductId" class="fw-bold">@item.Subtotal.ToEgp()</span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-remove-from-cart
                                                data-product-id="@item.ProductId" data-product-name="@item.ProductName" aria-label="Remove @item.ProductName">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card summary-card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Order summary</h5>
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span id="cart-total" class="fs-4 fw-bold text-primary">@Model.Total.ToEgp()</span>
                    </div>
                    <p class="small text-muted">Payment: cash on delivery.</p>
                    <hr />
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg w-100 rounded-pill mb-2">
                        Checkout <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill">Continue shopping</a>
                </div>
            </div>
        </div>
    </div>
}
