@model ProductListViewModel

@if (!Model.Products.Any())
{
    <div class="card border-0 shadow-sm text-center py-5 my-4">
        <div class="card-body">
            <i class="fa-solid fa-magnifying-glass fa-2x text-muted mb-3"></i>
            <h5>No products match your search</h5>
            <p class="text-muted mb-0">Try different keywords or clear the filters.</p>
        </div>
    </div>
}
else
{
    <p class="text-muted small mb-3">@Model.TotalCount @(Model.TotalCount == 1 ? "product" : "products") found</p>

    <div class="row g-4 mb-4">
        @foreach (var product in Model.Products)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <partial name="_ProductCard" model="product" />
            </div>
        }
    </div>

    <partial name="_Pager" model="@(new PagerViewModel
    {
        PageNumber = Model.PageNumber,
        TotalPages = Model.TotalPages,
        Action = "Index",
        Controller = "Products",
        RouteValues = new Dictionary<string, object?>
        {
            ["search"] = Model.SearchQuery,
            ["categoryId"] = Model.SelectedCategoryId,
            ["sort"] = Model.Sort
        }
    })" />
}
