@model ProductFormViewModel
@{
    var placeholder = Url.Content("~/images/default-product.svg");
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<input type="hidden" asp-for="ImageUrl" />

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4">
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" maxlength="100" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                        <span class="input-group-text">EGP</span>
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Stock" class="form-label fw-semibold"></label>
                    <input asp-for="Stock" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                    <select asp-for="CategoryId" asp-items="@((SelectList)ViewBag.Categories)" class="form-select">
                        <option value="">Select a category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                <input asp-for="ImageFile" type="file" class="form-control" id="imageFileInput" accept="image/*" />
                <div class="form-text">Choose an image from your computer (JPG, PNG, WEBP). Leave empty to keep the current/default image.</div>
                <span asp-validation-for="ImageFile" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch mt-2">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 text-center">
            <div class="fw-semibold mb-3 text-start">Image preview</div>
            <div class="position-relative d-inline-block mx-auto">
                <img id="imagePreview" 
                     class="img-fluid rounded border shadow-sm style-preview" 
                     src="@(string.IsNullOrEmpty(Model.ImageUrl) ? placeholder : Url.Content(Model.ImageUrl))" 
                     data-placeholder="@placeholder" 
                     alt="Image preview" 
                     style="max-height: 250px; object-fit: cover;" />
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <button type="submit" class="btn btn-primary rounded-pill px-4">
        <i class="fa-solid fa-floppy-disk me-1"></i> Save product
    </button>
    <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
</div>

<script>
    document.getElementById('imageFileInput')?.addEventListener('change', function (e) {
        const file = e.target.files[0];
        const preview = document.getElementById('imagePreview');
        
        if (file && preview) {
            const reader = new FileReader();
            reader.onload = function (evt) {
                preview.src = evt.target.result;
            };
            reader.readAsDataURL(file);
        }
    });
</script>