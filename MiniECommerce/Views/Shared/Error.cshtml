@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <div class="status-code">500</div>
    <h2 class="fw-bold mt-2">Something went wrong</h2>
    <p class="text-muted mb-4">We hit an unexpected problem while processing your request. Please try again in a moment.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">Back to home</a>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mt-4 mb-0">Reference: <code>@Model.RequestId</code></p>
    }
</div>
