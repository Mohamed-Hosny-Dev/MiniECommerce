@model MiniECommerce.Models.Product
@{
    var outOfStock = Model.Stock <= 0;
    var lowStock = !outOfStock && Model.Stock <= 5;
    var placeholder = Url.Content("~/images/default-product.svg");
}

<div class="card product-card h-100 shadow-sm @(outOfStock ? "is-out" : "")">
    <a class="media" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" tabindex="-1" aria-hidden="true">
        <img src="@Url.ProductImage(Model.ImageUrl)" data-fallback="@placeholder" alt="" loading="lazy" />
    </a>
    @if (Model.Category != null)
    {
        <span class="badge badge-cat rounded-pill">@Model.Category.Name</span>
    }
    @if (outOfStock)
    {
        <span class="badge badge-stock text-bg-dark rounded-pill">Out of stock</span>
    }
    else if (lowStock)
    {
        <span class="badge badge-stock text-bg-warning rounded-pill">Only @Model.Stock left</span>
    }

    <div class="card-body d-flex flex-column">
        <a class="title mb-1" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
        <p class="desc mb-3">@Model.Description</p>
        <div class="d-flex justify-content-between align-items-center mt-auto gap-2">
            <span class="price">@Model.Price.ToEgp()</span>
            @if (outOfStock)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" disabled>Sold out</button>
            }
            else
            {
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3" data-add-to-cart data-product-id="@Model.Id">
                    <i class="fa-solid fa-cart-plus"></i> Add
                </button>
            }
        </div>
    </div>
</div>
