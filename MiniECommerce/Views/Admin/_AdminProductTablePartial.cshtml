@model ProductListViewModel
@{
    var placeholder = Url.Content("~/images/default-product.svg");
}

@if (!Model.Products.Any())
{
    <div class="alert alert-warning text-center">No products found.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <!-- 1. إضافة table-striped و table-hover لتحسين قابلية القراءة وربط الصفوف -->
            <table class="table table-striped table-hover align-middle mb-0">
                <!-- 2. إضافة حدود سفلية لرأس الجدول لتمییزه عن البیانات -->
                <thead class="table-light border-bottom border-secondary-subtle">
                    <tr>
                        <th class="ps-3">Product</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Visibility</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr class="@(p.IsActive ? "" : "table-secondary")">
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@Url.ProductImage(p.ImageUrl)" data-fallback="@placeholder" class="thumb-sm rounded border shadow-sm" alt="" style="object-fit: cover;" />
                                    <div>
                                        <div class="fw-semibold text-dark">@p.Name</div>
                                        <div class="small text-muted">@p.Category?.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-medium text-secondary">@p.Price.ToEgp()</td>
                            <td>
                                <!-- 3. توحيد شكل المخزون (Pill) لجميع الحالات مع إضافة مساحة داخلية px-3 -->
                                @if (p.Stock <= 0) { 
                                    <span class="badge rounded-pill text-bg-danger px-3">Sold out</span> 
                                }
                                else if (p.Stock <= 5) { 
                                    <span class="badge rounded-pill text-bg-warning px-3">@p.Stock left</span> 
                                }
                                else { 
                                    <span class="badge rounded-pill text-bg-light border px-3 text-secondary">@p.Stock</span> 
                                }
                            </td>
                            <td>
                                @if (p.IsActive) { 
                                    <span class="badge rounded-pill text-bg-success px-3">Visible</span> 
                                }
                                else { 
                                    <span class="badge rounded-pill text-bg-secondary px-3">Hidden</span> 
                                }
                            </td>
                            <td class="text-end text-nowrap pe-3">
                                <!-- 4. تجميع الأزرار في btn-group لتقليل التشتت البصري -->
                                <div class="btn-group shadow-sm" role="group" aria-label="Product Actions">
                                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle-product data-product-id="@p.Id"
                                            title="@(p.IsActive ? "Hide from store" : "Show in store")">
                                        <i class="fa-solid @(p.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                            data-delete-product 
                                            data-product-id="@p.Id" 
                                            data-product-name="@p.Name"
                                            title="Delete product">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <p class="text-muted small mb-0">Showing @Model.TotalCount product(s)</p>
        
        <partial name="_Pager" model="@(new PagerViewModel
        {
            PageNumber = Model.PageNumber,
            TotalPages = Model.TotalPages,
            Action = "Products",
            Controller = "Admin",
            RouteValues = new Dictionary<string, object?> { ["search"] = Model.SearchQuery }
        })" />
    </div>
}