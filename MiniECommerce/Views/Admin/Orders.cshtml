@model AdminOrderListViewModel
@{
    ViewData["Title"] = "Orders Management";
}

<h1 class="h2 fw-bold mb-4"><i class="fa-solid fa-list-check text-primary me-2"></i>Orders</h1>

<div class="card border-0 shadow-sm p-3 mb-4">
    <div class="row g-2">
        <div class="col-md-6">
            <input type="search" id="orderSearchInput" class="form-control" value="@Model.Search" placeholder="Search by order #, customer name or phone..." aria-label="Search orders" />
        </div>
        <div class="col-md-4">
            <select id="orderStatusFilter" class="form-select" aria-label="Status filter">
                <option value="">All statuses</option>
                @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                {
                    <option value="@((int)status)" selected="@(Model.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="button" id="resetOrderFilter" class="btn btn-outline-secondary w-100"><i class="fa-solid fa-rotate-left"></i> Reset</button>
        </div>
    </div>
</div>

<div id="ordersContainer">
    <partial name="_OrderListPartial" model="Model" />
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
