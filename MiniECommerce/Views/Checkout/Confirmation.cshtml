@model Order
@{
    ViewData["Title"] = "Order confirmed";
}

<div class="text-center py-4">
    <div class="mb-3"><i class="fa-solid fa-circle-check text-success fa-5x"></i></div>
    <h1 class="fw-bold h2">Thank you! Your order has been received</h1>
    <p class="lead text-muted">Your order number is <strong>#@Model.Id</strong></p>

    <div class="card border-0 shadow-sm d-inline-block text-start p-4 mt-3 w-100" style="max-width: 520px;">
        <h5 class="fw-bold mb-3">Shipping summary</h5>
        <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
        <p class="mb-1"><strong>Phone:</strong> @Model.CustomerPhone</p>
        <p class="mb-1"><strong>Address:</strong> @Model.Address, @Model.City, @Model.Governorate</p>
        <p class="mb-1"><strong>Total:</strong> <span class="text-primary fw-bold">@Model.TotalAmount.ToEgp()</span> (cash on delivery)</p>
        <p class="mb-0"><strong>Status:</strong> <partial name="_StatusBadge" model="Model.Status" /></p>
    </div>

    <div class="mt-4 d-flex gap-2 justify-content-center">
        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">View order</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">Continue shopping</a>
    </div>
</div>
